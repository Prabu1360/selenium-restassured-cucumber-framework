# Build stage
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

COPY pom.xml .
COPY src ./src

RUN mvn clean package -DskipTests

# Runtime stage - with Chrome and Firefox
FROM eclipse-temurin:17-jdk

WORKDIR /app

# Install multiple browsers and dependencies
RUN apt-get update && apt-get install -y \
    chromium-browser \
    firefox \
    curl \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy built application from builder stage
COPY --from=builder /app/target /app/target
COPY --from=builder /app/pom.xml /app/pom.xml
COPY --from=builder /app/src /app/src
COPY --from=builder /root/.m2 /root/.m2

# Copy test resources
COPY src/test/resources /app/src/test/resources

# Set environment variables
ENV BROWSER=${BROWSER:-chrome}
ENV HEADLESS=true
ENV TEST_SUITE=${TEST_SUITE:-all}

# Run Maven with parallel execution (3 threads)
CMD ["mvn", "clean", "test", "-Dheadless.mode=true", "-DthreadCount=3", "-Dparallel=all"]
