# Browser Configuration
browser=chrome
headless.mode=false

# UI Application
base.url=https://eventhub.rahulshettyacademy.com/login
ui.username=your-email@example.com
ui.password=your-password

# API Configuration
api.base.url=https://api.eventhub.rahulshettyacademy.com/api/

# Wait Configuration (in seconds)
implicit.wait=10
explicit.wait=15

# Screenshot Configuration
screenshot.path=target/screenshots

# Report Configuration
report.path=target/cucumber-reports
